#!/bin/sh
# busybody-run — wrap an HTTP dev app, register it with a busybody directory,
# and heartbeat every 60s. POSIX sh. Requires: curl, ss (iproute2).
#
# Usage:
#   busybody-run --name NAME [--port PORT] [--host HOST] [--registry-url URL] -- CMD [ARGS...]
set -u

NAME=""
PORT=""
HOST="$(hostname)"
REGISTRY_URL="http://localhost:5150"

while [ $# -gt 0 ]; do
    case "$1" in
        --name)         NAME="$2"; shift 2 ;;
        --port)         PORT="$2"; shift 2 ;;
        --host)         HOST="$2"; shift 2 ;;
        --registry-url) REGISTRY_URL="$2"; shift 2 ;;
        --)             shift; break ;;
        *) echo "busybody-run: unknown flag $1" >&2; exit 2 ;;
    esac
done

if [ -z "$NAME" ]; then echo "busybody-run: --name is required" >&2; exit 2; fi
if [ $# -eq 0 ]; then echo "busybody-run: no command after --" >&2; exit 2; fi

# Launch the child in the background; $! is then the app's own PID.
"$@" &
CHILD_PID=$!

forward() { kill -s "$1" "$CHILD_PID" 2>/dev/null || true; }
trap 'forward TERM' TERM
trap 'forward INT' INT

# Discover the child's first LISTEN port unless --port was given.
discover_port() {
    ss -Htlnp 2>/dev/null | awk -v pid="$CHILD_PID" '
        $0 ~ ("pid=" pid ",") {
            split($4, a, ":"); print a[length(a)]; exit
        }'
}

resolve_port() {
    if [ -n "$PORT" ]; then echo "$PORT"; return; fi
    i=0
    while [ "$i" -lt 50 ]; do          # ~10s at 200ms
        p=$(discover_port)
        if [ -n "$p" ]; then echo "$p"; return; fi
        sleep 0.2
        i=$((i + 1))
    done
    # keep trying past the timeout, but warn once
    echo "busybody-run: no listening port after ~10s; still watching" >&2
    while kill -0 "$CHILD_PID" 2>/dev/null; do
        p=$(discover_port)
        if [ -n "$p" ]; then echo "$p"; return; fi
        sleep 0.2
    done
}

# Escape backslashes and double-quotes for safe embedding in a JSON string.
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

register() {
    _name=$(json_escape "$NAME")
    _host=$(json_escape "$HOST")
    curl -fsS -m 3 -X POST "$REGISTRY_URL/api/register" \
        -H "Content-Type: application/json" \
        -d "{\"name\":\"$_name\",\"port\":$1,\"pid\":\"$CHILD_PID\",\"host\":\"$_host\"}" \
        >/dev/null 2>&1 \
        || echo "busybody-run: register failed (will retry)" >&2
}

# Resolve + register + heartbeat in the background so we can wait on the child.
(
    RP=$(resolve_port)
    [ -z "$RP" ] && exit 0
    register "$RP"
    while kill -0 "$CHILD_PID" 2>/dev/null; do
        sleep 60
        kill -0 "$CHILD_PID" 2>/dev/null || break
        register "$RP"
    done
) &
HB_PID=$!

# Wait for the child and propagate its real exit code. A trapped signal
# interrupts wait with status >128; re-wait until the child is actually gone
# so CODE reflects the child's own exit status, not the interrupted wait.
while :; do
    wait "$CHILD_PID"
    CODE=$?
    kill -0 "$CHILD_PID" 2>/dev/null || break
done
kill "$HB_PID" 2>/dev/null || true
exit "$CODE"
